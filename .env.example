NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only administrator and privileged Supabase configuration. Never use NEXT_PUBLIC_ prefixes.
SUPABASE_SECRET_KEY=replace-with-server-only-supabase-secret-key
BRASS_ADMIN_EMAIL=admin@example.com
# Generate a scrypt hash with: npm run admin:hash
BRASS_ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
# Generate at least 32 random bytes; used for signed administrator sessions and rate-limit keys.
BRASS_ADMIN_SESSION_SECRET=replace-with-32-random-bytes
# Database tests only: disposable local Supabase; never use a production project.
# TEST_SUPABASE_URL=http://127.0.0.1:54321
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_SUPABASE_SECRET_KEY=
# BRASS_ALLOW_LOCAL_SERVICE_ROLE_TESTS=1
